# Jortt API credentials (client credentials grant).
# Register your app in Jortt and copy its Client ID and Client Secret here.
#
# Where jortt reads settings from (earlier wins, per key; only JORTT_* keys are read):
#   1. real environment variables
#   2. the file named in JORTT_ENV_FILE
#   3. ./.env in the current folder   <- this file, while developing in this repo
#   4. ~/.config/jortt/.env           <- used by the installed `jortt` binary
#                                        (`bun run install:local` links it to this file)
JORTT_CLIENT_ID=
JORTT_CLIENT_SECRET=

# Space-separated scopes to request. They must be the same as, or fewer than, the
# scopes your app was registered with in Jortt, or getting a token fails.
# `all:read all:write` also works if your app was registered with those.
JORTT_SCOPES="organizations:read customers:read customers:write invoices:read invoices:write estimates:read estimates:write expenses:read expenses:write receipts:read inbox:write reports:read financing:read reconciling:read reconciling:write"

# Only needed if your credentials can act on more than one administration
# (`jortt organizations list` shows them). Sent as the Organization-Id header.
# JORTT_ORGANIZATION_ID=

# Optional overrides (defaults shown).
# JORTT_API_URL=https://api.jortt.nl
# JORTT_TOKEN_URL=https://app.jortt.nl/oauth-provider/oauth/token
# JORTT_CONFIG_DIR=~/.config/jortt
